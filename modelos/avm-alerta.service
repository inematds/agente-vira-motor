# Alerta do dia (zero token). Copie para ~/.config/systemd/user/ e ajuste RAIZ e ENVIO.
[Unit]
Description=alerta-conserta-motor: alerta do dia

[Service]
Type=oneshot
Environment=KIT=%h/projetos/alerta-conserta-motor
Environment=RAIZ=%h/projetos
# ENVIO recebe o texto curto pelo stdin. Ex.: um script seu que manda para o Telegram/WhatsApp/e-mail.
Environment=ENVIO=cat
ExecStart=/bin/sh -c 'mkdir -p "$KIT/alertas"; python3 "$KIT/alerta.py" --raiz "$RAIZ" --saida "$KIT/alertas/$(date +%%F).md" --curto | $ENVIO; exit 0'
TimeoutStartSec=300
MemoryMax=1G
